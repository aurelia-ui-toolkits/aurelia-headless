{
  "name": "@aurelia-ui-toolkits/headless-tailwind-compact",
  "version": "1.0.10",
  "description": "Compact Tailwind CSS theme for @aurelia-ui-toolkits/headless",
  "license": "MIT",
  "author": "Maxim Balaganskiy <m.balaganskiy@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aurelia-ui-toolkits/aurelia-headless.git",
    "directory": "packages/tailwind-compact"
  },
  "homepage": "https://aurelia-ui-toolkits.github.io/aurelia-headless/",
  "bugs": {
    "url": "https://github.com/aurelia-ui-toolkits/aurelia-headless/issues"
  },
  "keywords": [
    "aurelia",
    "aurelia2",
    "headless",
    "tailwindcss",
    "theme",
    "compact"
  ],
  "type": "module",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.css"
    },
    "./theme.css": {
      "types": "./src/css.d.ts",
      "default": "./src/theme.css"
    },
    "./*.css": {
      "types": "./src/css.d.ts",
      "default": "./src/*.css"
    }
  },
  "peerDependencies": {
    "tailwindcss": ">=4.0.0"
  },
  "files": [
    "src"
  ]
}
